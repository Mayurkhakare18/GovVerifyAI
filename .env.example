# ==============================================================================
# GovVerify AI — Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit actual secrets or credentials to source control.
# ==============================================================================

# Server-Side Supabase Configuration (SERVER ONLY - NEVER EXPOSE SECRET KEY TO BROWSER)
# Required for server-side verification requests, API authorization, and database persistence.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key_here"
SUPABASE_SECRET_KEY="sb_secret_your_secret_role_key_here"

# Direct PostgreSQL Connection URL (Optional - for migration runners / direct SQL CLI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres"

# Client-Side Supabase Configuration (PUBLIC - Bundled with browser assets via Vite)
# Note: Uses anonymous/publishable key only. Row-Level Security (RLS) protects citizen data.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_your_publishable_key_here"

# Optional Decoupled API Base URL (PUBLIC)
# Leave empty ("") when using Vercel Serverless Functions on the same origin (recommended).
# Set to "https://api.yourdomain.com" only if hosting Express/Worker on a separate container (e.g. Render/Railway).
VITE_API_BASE_URL=""

# Application Hosting & Port
PORT=3000
NODE_ENV="production"
APP_URL="https://your-app.vercel.app"
CORS_ALLOWED_ORIGIN="*"

# Google Gemini API Configuration (SERVER ONLY)
# Required for Sovereign Grounding, Verdict Synthesis, and Native PDF Extraction.
GEMINI_API_KEY="your_gemini_api_key_here"

# Tavily Search API Configuration (SERVER ONLY)
# Sovereign Source Discovery Provider. Set DISCOVERY_PROVIDER to 'auto', 'tavily', or 'gemini'.
TAVILY_API_KEY="tvly-your_tavily_api_key_here"
DISCOVERY_PROVIDER="auto"
